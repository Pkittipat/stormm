# Live sessions (optional). Copy to .env and fill in from your Supabase project's
# Settings → API. Both values are public by design — they ship in the bundle, and a
# public Realtime channel needs nothing more. No tables, no policies, no sign-in.
#
# Leave them unset and the app works as it always has, with live sessions switched off.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
